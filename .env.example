DATABASE_URL="postgresql://user:password@localhost:5432/my_ai_project"
JWT_SECRET="your_secure_random_string_here"
PORT=3000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# Redis Config (Used for Queues & Caching)
ENABLE_REDIS="true"
REDIS_URL="redis://localhost:6379"

# Email Configuration (SMTP)
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"

# Sentry Monitoring
SENTRY_DSN="your_sentry_dsn"
SENTRY_ENVIRONMENT="development"
SENTRY_RELEASE="hrms-api@1.0.0"

# OpenTelemetry / Jaeger
JAEGER_ENDPOINT="http://localhost:14268/api/traces"

# AWS / Storage Config
STORAGE_PROVIDER="local" # Options: local, s3
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_access_key"
AWS_SECRET_ACCESS_KEY="your_secret_key"
AWS_S3_BUCKET="hrms-bucket"

# Feature Flags
ENABLE_ADVANCED_BIOMETRICS="false"
ENABLE_TDS_ENGINE="true"
LOG_LEVEL="info"
